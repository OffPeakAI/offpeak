# oven/bun:1.4.4-slim, pinned by digest. Debian, because the NVIDIA runtime mounts a glibc nvidia-smi into the container.
FROM oven/bun@sha256:1846adf22496bd711036aae8be147e57bdebbaea2e5264e3e0b5af1db187d9a4
WORKDIR /app
COPY . .
RUN bun install --frozen-lockfile --production
USER bun
CMD ["bun", "run", "apps/host-agent/src/main.ts"]
