# Supply through your secret manager or a local environment file. No real keys here.
BURSAR_GATEWAY_ORIGIN=https://your-merchant-origin.example
BURSAR_RPC_URL=https://your-chain-4663-rpc.example
BURSAR_MERCHANT_KEY=replace-me
BURSAR_ESCROW=replace-with-verified-escrow-address
BURSAR_FACTORY=replace-with-verified-factory-address
BURSAR_USDG=replace-with-verified-six-decimal-usdg-address
BURSAR_PRICE_MICRO=10000
BURSAR_MODELS=your-deployed-model
BURSAR_CAPABILITY=service:inference.text
BURSAR_DATABASE_URL=postgres://gateway:replace-me@127.0.0.1:5432/bursar_gateway
OFFPEAK_PUBLIC_BASE_URL=https://your-offpeak-router.example
OFFPEAK_API_KEY=replace-me
PORT=8793
